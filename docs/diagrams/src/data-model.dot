// My Local Shop: main SQLite tables (subset of columns) from database/db_manager.py in the private repo.
// Dashed edge = column used as a link but not declared as a FOREIGN KEY.
// Most tables also store the acting user (user_id / created_by_user_id); those edges are left out for readability.
digraph data_model {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, nodesep=0.35, ranksep=0.8, pad=0.3, bgcolor="white"];
  node  [shape=plain, fontname="Helvetica", fontsize=10];
  edge  [color="#666666", arrowsize=0.7];

  users [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#888888">
    <tr><td bgcolor="#e4eefb"><b>users</b></td></tr>
    <tr><td align="left" port="id">id (PK)</td></tr><tr><td align="left">username, pin</td></tr>
    <tr><td align="left">role (admin, manager, cashier)</td></tr><tr><td align="left">status, last_login</td></tr></table>>];

  products [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#888888">
    <tr><td bgcolor="#e4eefb"><b>products</b></td></tr>
    <tr><td align="left" port="id">id (PK)</td></tr><tr><td align="left">product_code (UNIQUE)</td></tr>
    <tr><td align="left">name, category, barcode</td></tr><tr><td align="left">price, cost_price</td></tr>
    <tr><td align="left">discount_type, discount_value</td></tr><tr><td align="left">stock, low_stock_threshold</td></tr>
    <tr><td align="left">batch_number, expiry_date</td></tr></table>>];

  customers [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#888888">
    <tr><td bgcolor="#e4eefb"><b>customers</b></td></tr>
    <tr><td align="left" port="id">id (PK)</td></tr><tr><td align="left">name, phone (UNIQUE)</td></tr>
    <tr><td align="left">current_balance, credit_limit</td></tr></table>>];

  sales [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#888888">
    <tr><td bgcolor="#e4eefb"><b>sales</b></td></tr>
    <tr><td align="left" port="id">id (PK)</td></tr><tr><td align="left" port="user">user_id (FK)</td></tr>
    <tr><td align="left" port="cust">customer_id</td></tr><tr><td align="left">subtotal_amount, vip_discount_amount</td></tr>
    <tr><td align="left">total_amount, payment_method</td></tr><tr><td align="left">cash_received, change_given</td></tr>
    <tr><td align="left">sale_date, receipt_html</td></tr></table>>];

  sale_items [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#888888">
    <tr><td bgcolor="#e4eefb"><b>sale_items</b></td></tr>
    <tr><td align="left" port="id">id (PK)</td></tr><tr><td align="left" port="sale">sale_id (FK)</td></tr>
    <tr><td align="left" port="prod">product_id (FK)</td></tr><tr><td align="left">product_name (snapshot)</td></tr>
    <tr><td align="left">quantity, price_at_sale</td></tr><tr><td align="left">product_discount_amount</td></tr>
    <tr><td align="left">returned_quantity</td></tr></table>>];

  returns [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#888888">
    <tr><td bgcolor="#e4eefb"><b>returns</b></td></tr>
    <tr><td align="left" port="sale">sale_id (FK)</td></tr><tr><td align="left" port="item">sale_item_id (FK)</td></tr>
    <tr><td align="left">quantity, refund_amount, reason</td></tr></table>>];

  credit_tx [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#888888">
    <tr><td bgcolor="#e4eefb"><b>credit_transactions</b></td></tr>
    <tr><td align="left" port="id">id (PK)</td></tr><tr><td align="left" port="cust">customer_id (FK)</td></tr>
    <tr><td align="left" port="sale">sale_id (FK)</td></tr><tr><td align="left">amount, paid_amount</td></tr>
    <tr><td align="left">remaining_balance, status</td></tr></table>>];

  credit_pay [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#888888">
    <tr><td bgcolor="#e4eefb"><b>credit_payments</b></td></tr>
    <tr><td align="left" port="cust">customer_id (FK)</td></tr><tr><td align="left" port="tx">credit_transaction_id (FK)</td></tr>
    <tr><td align="left">amount, payment_date, notes</td></tr></table>>];

  suppliers [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#888888">
    <tr><td bgcolor="#e4eefb"><b>suppliers</b></td></tr>
    <tr><td align="left" port="id">id (PK)</td></tr><tr><td align="left">name, phone, email, address</td></tr>
    <tr><td align="left">liability</td></tr></table>>];

  po [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#888888">
    <tr><td bgcolor="#e4eefb"><b>purchase_orders</b></td></tr>
    <tr><td align="left" port="id">id (PK)</td></tr><tr><td align="left" port="sup">supplier_id (FK)</td></tr>
    <tr><td align="left">total_amount, status</td></tr><tr><td align="left">created_at, received_at</td></tr></table>>];

  po_items [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#888888">
    <tr><td bgcolor="#e4eefb"><b>po_items</b></td></tr>
    <tr><td align="left" port="po">po_id (FK)</td></tr><tr><td align="left" port="prod">product_id (FK)</td></tr>
    <tr><td align="left">quantity, expected_price</td></tr><tr><td align="left">received_quantity</td></tr></table>>];

  other [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#888888">
    <tr><td bgcolor="#f1f1ec"><b>also</b></td></tr>
    <tr><td align="left"><b>expenses</b>: category, amount, description</td></tr>
    <tr><td align="left"><b>commissions</b>: company, commission_type, amount, target_count</td></tr>
    <tr><td align="left"><b>audit_logs</b>: user, action, details, timestamp</td></tr>
    <tr><td align="left"><b>settings</b>: shop_name, shop_address, shop_contact</td></tr></table>>];

  sales:user -> users:id;
  sales:cust -> customers:id [style=dashed];
  sale_items:sale -> sales:id;
  sale_items:prod -> products:id;
  returns:sale -> sales:id;
  returns:item -> sale_items:id;
  credit_tx:cust -> customers:id;
  credit_tx:sale -> sales:id;
  credit_pay:cust -> customers:id;
  credit_pay:tx -> credit_tx:id;
  po:sup -> suppliers:id;
  po_items:po -> po:id;
  po_items:prod -> products:id;
}
